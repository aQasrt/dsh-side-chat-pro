{
  "name": "dsh-side-chat-pro",
  "version": "0.1.0",
  "description": "侧边聊天 Pro — 划词三选一：选中对话里的文字，可开侧边子会话提问，也可就地翻译或解释名词。翻译结合上下文给出 1-5 个候选译法。基于 dsh-side-chat-plus (MIT) 修改。",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GITHUB_USER/dsh-side-chat-pro.git"
  },
  "homepage": "https://github.com/GITHUB_USER/dsh-side-chat-pro#readme",
  "bugs": {
    "url": "https://github.com/GITHUB_USER/dsh-side-chat-pro/issues"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "plugin",
    "side-chat",
    "sidechat",
    "translate",
    "explain",
    "selection"
  ],
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./icon": "./assets/icon.svg",
    "./locale/*": "./locale/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client-registry.js",
    "lib/**/*.map",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "assets",
    "locale",
    "src",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "license": "MIT",
  "dependencies": {
    "schemastery": "npm:@deepseek-ai/schemastery@3.18.6-alpha.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.1",
    "@deepseek-ai/dsh-attachment": ">=0.2.1-rc.1",
    "@deepseek-ai/dsh-client-locale": ">=0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.1-rc.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.1-rc.1",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.1",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.1",
    "@deepseek-ai/dsh-session-query": ">=0.2.1-rc.1",
    "@deepseek-ai/dsh-workspace": ">=0.2.1-rc.1",
    "@deepseek-ai/dsh-permission-presets": ">=0.2.1-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.2.1-rc.1",
    "@deepseek-ai/dsh-settings": ">=0.2.1-rc.1",
    "@deepseek-ai/dsh-home-paths": ">=0.2.1-rc.1",
    "cordis": "^4.0.0-rc.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.2.1-rc.1"
  },
  "scripts": {}
}
